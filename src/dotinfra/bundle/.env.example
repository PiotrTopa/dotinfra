# Copy to .env and edit. .env is read by `docker compose` and must not be committed.
#
# Fill the password straight from the dotinfra vault (nothing is echoed):
#   dotinfra vault exec grafana_password -- sh -c 'IFS= read -r p; printf "GRAFANA_ADMIN_PASSWORD=%s\n" "$p" >> .env'

GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# PROMETHEUS_RETENTION=90d
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# PUSHGATEWAY_PORT=9091

