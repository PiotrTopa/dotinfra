# Copy to .env and edit. .env is read by `docker compose` and must not be committed.
#
# Fill the password straight from the dotinfra vault (nothing is echoed):
#   dotinfra vault exec grafana_password -- sh -c 'IFS= read -r p; printf "GRAFANA_ADMIN_PASSWORD=%s\n" "$p" >> .env'

GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# PROMETHEUS_RETENTION=90d
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# PUSHGATEWAY_PORT=9091

# Pinned images; bump deliberately. Adopting an existing Grafana volume? Set
# GRAFANA_IMAGE to at least the version it runs now (`docker exec <grafana>
# grafana server -v`): an older Grafana on a newer database can corrupt it.
# See "Adopting an existing stack" in README.md.
# PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
# GRAFANA_IMAGE=grafana/grafana:13.2.2
# PUSHGATEWAY_IMAGE=prom/pushgateway:v1.11.3
# NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
# DCGM_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.2.3-4.1.1-ubuntu22.04
